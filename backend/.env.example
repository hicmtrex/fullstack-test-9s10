# General
NODE_ENV=development
PORT=3001

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=travel_agency

# JWT secrets (use long random strings in real .env)
JWT_ACCESS_SECRET=secret_123458
JWT_REFRESH_SECRET=secret_refresh_123458

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d